# Переменные окружения функции /api/lead.
# Значения задаются в настройках Vercel (Project → Settings → Environment Variables), а не в репозитории.
# Для локального запуска скопируйте файл в .env и заполните. Файл .env в git не попадает.
# Если канал не настроен, он считается неудавшимся и в сеть не выходит; заявка уходит через второй канал.

# --- Telegram: уведомление владельцу ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Числовой id чата или группы, куда писать (узнать у @userinfobot или через getUpdates)
TELEGRAM_CHAT_ID=

# --- Почта (SMTP) ---
# Адрес SMTP-сервера, например smtp.yandex.ru
SMTP_HOST=
# Порт: 465 (TLS сразу) или 587 (STARTTLS)
SMTP_PORT=
# Логин почтового ящика
SMTP_USER=
# Пароль почты или пароль приложения
SMTP_PASS=
# Адрес отправителя, обычно совпадает с логином
MAIL_FROM=
# Адрес, куда приходят заявки
MAIL_TO=
